# ============================================================================
# .env.example — copy to `.env` and fill in. NEVER commit a real .env.
#
#     cp .env.example .env   &&   $EDITOR .env
#
# docker-compose reads `.env` for BOTH: (1) variable interpolation in the compose
# file and (2) `env_file:` injection of these vars into the container. Keep this
# file to credentials + wandb mode only — do NOT add HF_HOME / paths here, or you
# would override the image's in-container paths.
# ============================================================================

# Hugging Face token.
#   Required ONLY for gated models — google/gemma-3-12b-it (experiments #5/6/8/9):
#   accept the license on the model page, create a READ token, paste it here.
#   Ungated models (Qwen2.5-VL-7B, InternVL3_5-8B) need no token, but setting one
#   avoids anonymous rate limits. Leave blank if you only run the ungated matrix.
HF_TOKEN=

# Weights & Biases.
#   Default is OFFLINE (logs locally to ./outputs, no account, no network). To
#   sync online, set WANDB_MODE=online below AND paste your own key here.
WANDB_API_KEY=
WANDB_MODE=offline

# ---------------------------------------------------------------------------
# OPTIONAL host bind-mount overrides (compose interpolation only; commented out
# so they are NOT injected into the container). Uncomment to relocate the mounts:
# HOST_HF_CACHE=./cache/hf
# HOST_DATA=./data
# HOST_OUTPUTS=./outputs
